<UserControl x:Class="PassWordStorageTool.Views.Pages.PassWordRegionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PassWordStorageTool.Views.Pages"
             mc:Ignorable="d" 
             xmlns:p="http://prismlibrary.com/"
             xmlns:entity="clr-namespace:PassWordStorageTool.Entitys"
             p:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border>
            <DataGrid ItemsSource="{Binding LoginUser.Accounts}" AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"  IsReadOnly="True" RowHeaderWidth="0" 
                      >
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="1*"  Header="用户名">
                        
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock  Text="{Binding UserName}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn  Width="1*" Header="密码">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding PassWord}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="1*"  Header="描述">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding Description}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="1*"  Header="网址">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding WebSite}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
    </Grid>
</UserControl>
