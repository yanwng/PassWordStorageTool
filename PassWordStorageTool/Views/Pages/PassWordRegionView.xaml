<UserControl x:Class="PassWordStorageTool.Views.Pages.PassWordRegionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PassWordStorageTool.Views.Pages"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:p="http://prismlibrary.com/"
             xmlns:entity="clr-namespace:PassWordStorageTool.Entitys"
             p:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="450" d:DesignWidth="800"
             FontSize="18"
             >

    <UserControl.Resources>

        <ContextMenu x:Key="GridContextMenu">
            <MenuItem Header="新增">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <p:InvokeCommandAction
                            Command="{Binding OpenAddAccountPage}"
                            />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>

            <MenuItem Header="删除">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <p:InvokeCommandAction
                    Command="{Binding Delete}"
                    TriggerParameterPath="Source.Parent.PlacementTarget.SelectedItem"
                     
                    />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
             <MenuItem Header="修改">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <p:InvokeCommandAction Command="{Binding Updata}"
                               TriggerParameterPath="Source.Parent.PlacementTarget.SelectedItem"
                               />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    
    <Grid>
        <Border Padding="0,0,20,20">
            <DataGrid x:Name="grid" ItemsSource="{Binding LoginUser.Accounts}" AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="True"
                      CanUserAddRows="False" CanUserDeleteRows="False"  IsReadOnly="True" RowHeaderWidth="0" 
                      ContextMenu="{StaticResource GridContextMenu}"  Background="#88E7D2" BorderThickness="0"
                      >
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" >
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#A82F4F"></Setter>
                                <Setter Property="Foreground" Value="#88E7D2"></Setter>
                               
                            </Trigger>
                        </Style.Triggers>


                        <Setter Property="Background" Value="#88E7D2"></Setter>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" >
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#A82F4F"></Setter>
                                <Setter Property="Foreground" Value="#88E7D2"></Setter>
                                <Setter Property="FontWeight" Value="Bold"></Setter>
                                <Setter Property="BorderThickness" Value="0"></Setter>
                                

                            </Trigger>
                        </Style.Triggers>

                        <Setter Property="Background" Value="Transparent"></Setter>
                        <Setter Property="Margin" Value="0"></Setter>
                        <Setter Property="BorderThickness" Value="0"></Setter>
                        
                    </Style>
                </DataGrid.CellStyle>

                


                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="1*"  Header="用户名">
                        
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock  Text="{Binding UserName}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn  Width="1*" Header="密码">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding PassWord}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="1*"  Header="描述">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding Description}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="1*"  Header="网址">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding WebSite}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
    </Grid>
</UserControl>
