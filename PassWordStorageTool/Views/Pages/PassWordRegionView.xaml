<UserControl x:Class="PassWordStorageTool.Views.Pages.PassWordRegionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PassWordStorageTool.Views.Pages"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:p="http://prismlibrary.com/"
             xmlns:entity="clr-namespace:PassWordStorageTool.Entitys"
             p:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        
        <ContextMenu x:Key="dataGrid">
            <MenuItem Header="删除">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <p:InvokeCommandAction
                            Command="{Binding Delete}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}, Path=SelectedItem}"
                            />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>
    
    <Grid>
        <Border>
            <DataGrid x:Name="grid" ItemsSource="{Binding LoginUser.Accounts}" AutoGenerateColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"  IsReadOnly="True" RowHeaderWidth="0" 
                      >
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="Click">
                                    <p:InvokeCommandAction
                                        Command="{Binding Delete}"
                                        TriggerParameterPath="Source.Parent.PlacementTarget.SelectedItem"
                                         
                                        />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <p:InvokeCommandAction Command="{Binding Updata}"
                                               TriggerParameterPath="Source.SelectedItem"
                                               />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="1*"  Header="用户名">
                        
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock  Text="{Binding UserName}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn  Width="1*" Header="密码">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding PassWord}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="1*"  Header="描述">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding Description}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Width="1*"  Header="网址">
                        <DataGridTemplateColumn.CellTemplate>
                            <ItemContainerTemplate>
                                <Border>
                                    <TextBlock Text="{Binding WebSite}"/>
                                </Border>
                            </ItemContainerTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
    </Grid>
</UserControl>
